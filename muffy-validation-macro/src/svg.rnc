# A driver schema for SVG documents modeled on the SVG driver schema of the
# Nu Html Checker. It composes the SVG schema with the HTML schema for foreign
# elements in `foreignObject` elements.

include "html.rnc"
include "schema/svg11/svg11.rnc"

common.elem.phrasing |= svg

SVG.Core.attrib &= aria.global?

SVG.foreignObject.content |=
    (	html.elem
    |	body.elem
    |	common.inner.flow
    )
